var gui = 1

var desktop   = ("/system/desktop/desktop.elf")
var login     = ("/system/desktop/login.elf")
var welcome   = ("/system/welcome.elf")

print("succesfully jumped into userspace... yay :3")

wait 150

if  gui
	exec  desktop
	exec  login
	exec  welcome
else
	print("[warning] gui not found")
	exec shell_path
endif
