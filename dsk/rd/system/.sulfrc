var gui = 1

var desktop = ("/system/desktop/desktop.elf")
var login   = ("/system/desktop/login.elf")
var welcome = ("/system/welcome.elf")
var system  = ("/system/desktop/system.elf")

print("succesfully jumped into userspace... yay :3")

wait 5

if  gui
    exec  system
	exec  desktop
	exec  login
	exec  welcome
else
	print("[warning] gui not active")
	exec shell_path
endif
